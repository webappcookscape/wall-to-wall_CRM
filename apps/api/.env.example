# Environment variables for Wall-to-Wall CRM API
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/wall2wall_crm?schema=public"

# Auth / JWT
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Meta (Facebook) Lead Ads Integration (Optional)
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_AUTO_CREATE_LEAD="false"

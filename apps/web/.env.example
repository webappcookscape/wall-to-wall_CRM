# Environment variables for the Cookscape CRM Frontend

# The base URL for the backend API.
# For local development, this defaults to http://localhost:5000/api/v1 if not set.
# For production deployment, set this to your live API endpoint.
# Example: VITE_API_URL=https://api.crm.cookscape.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
